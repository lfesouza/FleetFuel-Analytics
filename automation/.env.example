# Copy to .env (git-ignored) and fill in. Never commit the real values.

# Databricks workspace URL, without a trailing slash.
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com
# Personal access token (Settings > Developer > Access tokens).
# Used for the curl smoke tests; inside n8n it is stored as a Credential.
DATABRICKS_TOKEN=dapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SQL Warehouse ID (SQL Warehouses > your warehouse > Connection details).
DATABRICKS_WAREHOUSE_ID=xxxxxxxxxxxxxxxx
# Job ID of anp_fuel_pipeline (Jobs & Pipelines > the job > Job details).
DATABRICKS_JOB_ID=000000000000000

# Telegram bot token from @BotFather; inside n8n it is stored as a Credential.
TELEGRAM_BOT_TOKEN=0000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chat that receives the digest and alerts.
TELEGRAM_CHAT_ID=000000000

# Encrypts credentials stored by n8n. Generate once, e.g. `openssl rand -hex 32`.
N8N_ENCRYPTION_KEY=change-me
