    {
      "parameters": {
        "jsCode": "// Runs when a workflow that names this one as its error workflow fails.\nconst { workflow, execution } = $input.first().json;\nconst escape = text => String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst lines = [\n  '🔴 n8n workflow error',\n  `Workflow: ${escape(workflow?.name ?? 'unknown')}`,\n  `Node: ${escape(execution?.lastNodeExecuted ?? 'unknown')}`,\n  `Error: ${escape(execution?.error?.message ?? 'unknown')}`,\n];\n\nreturn [{ json: { text: lines.join('\\n') } }];\n"
      },
