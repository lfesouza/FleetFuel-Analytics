        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  warehouse_id: $env.DATABRICKS_WAREHOUSE_ID,\n  statement: \"SELECT coalesce(l.max_collection_date > max(p.max_collection_date), true) AS has_new_data, date_format(l.max_collection_date, 'dd/MM/yyyy') AS max_collection_date FROM (SELECT run_at, max_collection_date FROM anp_fuel.gold.ops_run_log ORDER BY run_at DESC LIMIT 1) l LEFT JOIN anp_fuel.gold.ops_run_log p ON CAST(p.run_at AS DATE) < CAST(l.run_at AS DATE) GROUP BY l.max_collection_date\",\n  wait_timeout: '30s',\n  on_wait_timeout: 'CONTINUE'\n}) }}",
        "options": {}
      },
