      "id": "bded6d5f-33b6-47bb-ad8f-b3cbcb76fa63",
      "name": "Ran today and succeeded?"
    },
    {
      "parameters": {
        "jsCode": "// The last run of the pipeline is not a success from today: report its state and link to it.\nconst run = $input.first().json.runs?.[0];\nconst escape = text => String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst lines = ['🔴 FleetFuel pipeline failed'];\nif (!run) {\n  lines.push('The job has no runs yet.');\n} else {\n  const started = DateTime.fromMillis(run.start_time).setZone('America/Sao_Paulo');\n  const state = run.state?.result_state ?? run.state?.life_cycle_state ?? 'UNKNOWN';\n  const ranToday = started.hasSame($now.setZone('America/Sao_Paulo'), 'day');\n  lines.push(ranToday ? `The run from today ended as ${state}.` : `No run today. Last run: ${state}.`);\n  lines.push(`Started: ${started.toFormat('dd/MM/yyyy HH:mm')}`);\n  if (run.state?.state_message) lines.push(escape(run.state.state_message));\n  lines.push(escape(run.run_page_url));\n}\n\nreturn [{ json: { text: lines.join('\\n') } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        260
      ],
      "id": "12d707ef-327d-4d3d-afc8-782e141b6d73",
      "name": "Build failure alert"
    },
    {
