        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  warehouse_id: $env.DATABRICKS_WAREHOUSE_ID,\n  statement: \"SELECT (SELECT coalesce(l.max_collection_date > max(p.max_collection_date), true) FROM (SELECT run_at, max_collection_date FROM anp_fuel.gold.ops_run_log ORDER BY run_at DESC LIMIT 1) l LEFT JOIN anp_fuel.gold.ops_run_log p ON CAST(p.run_at AS DATE) < CAST(l.run_at AS DATE) GROUP BY l.max_collection_date) AS has_new_data, (SELECT to_json(collect_list(named_struct('product', product, 'week_start', week_start, 'avg_price', avg_price, 'prev_avg_price', prev_avg_price, 'wow_change_pct', wow_change_pct))) FROM anp_fuel.gold.vw_weekly_national) AS national, (SELECT to_json(collect_list(named_struct('state', state, 'product', product, 'wow_change_pct', wow_change_pct, 'in_ranking', in_ranking, 'is_spike', is_spike))) FROM anp_fuel.gold.vw_weekly_state_changes) AS state_changes, (SELECT to_json(collect_list(named_struct('state', state, 'ratio', ratio, 'ethanol_pays', ethanol_pays, 'flipped_to_ethanol', flipped_to_ethanol, 'flipped_to_gasoline', flipped_to_gasoline))) FROM anp_fuel.gold.vw_fuel_ratio_current) AS fuel_ratio, (SELECT to_json(named_struct('ratio_threshold', ratio_threshold, 'spike_threshold_pct', spike_threshold_pct, 'min_stations', min_stations)) FROM anp_fuel.gold.digest_config) AS config\",\n  wait_timeout: '30s',\n  on_wait_timeout: 'CONTINUE'\n}) }}",
