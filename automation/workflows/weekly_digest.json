    {
      "parameters": {
        "jsCode": "// Builds the weekly digest text from the single-row result of the \"Submit statement\" query.\n// Each column is a JSON string: has_new_data, national, state_changes, fuel_ratio and config.\nconst res = $input.first().json;\nconst names = res.manifest.schema.columns.map(col => col.name);\nconst row = res.result.data_array[0];\nconst data = Object.fromEntries(names.map((name, i) => [name, JSON.parse(row[i])]));\n\nconst labels = { 'DIESEL S10': 'Diesel S10', 'DIESEL': 'Diesel', 'GASOLINA': 'Gasoline', 'ETANOL': 'Ethanol' };\nconst order = Object.keys(labels);\n\n// Round on whole hundredths first so 1.65 shows as 1.7, not 1.6.\nconst pct = value => (Math.round(Math.round(Math.abs(value) * 100) / 10) / 10).toFixed(1) + '%';\n// Same idea for prices kept with three decimals: 7.045 shows as 7.05.\nconst brl = value => 'R$' + (Math.round(Math.round(value * 1000) / 10) / 100).toFixed(2);\nconst signed = value => (value >= 0 ? '+' : '−') + pct(value);\nconst arrow = value => (value > 0 ? '▲' : value < 0 ? '▼' : '▬');\nconst list = items => (items.length ? items.join(', ') : 'none');\n\nconst national = [...data.national].sort((a, b) => order.indexOf(a.product) - order.indexOf(b.product));\nconst [year, month, day] = national[0].week_start.split('-');\n\nconst nationalLines = national.map(p =>\n  `• ${labels[p.product].padEnd(11)} ${brl(p.avg_price)}  ${arrow(p.wow_change_pct)} ${pct(p.wow_change_pct)}`\n);\n\n// Top 3 Diesel S10 increases among states with enough stations in both weeks.\nconst ranked = data.state_changes.filter(s => s.in_ranking);\nconst topIncreases = ranked\n  .filter(s => s.product === 'DIESEL S10' && s.wow_change_pct > 0)\n  .sort((a, b) => b.wow_change_pct - a.wow_change_pct)\n  .slice(0, 3)\n  .map((s, i) => `${i + 1}. ${s.state}  ${signed(s.wow_change_pct)}`);\n\nconst price = product => national.find(p => p.product === product).avg_price;\nconst nationalRatio = (price('ETANOL') / price('GASOLINA') * 100).toFixed(1);\nconst states = data.fuel_ratio;\nconst flippedTo = flag => states.filter(s => s[flag]).map(s => s.state).sort();\n\nconst spikes = data.state_changes\n  .filter(s => s.is_spike)\n  .sort((a, b) => b.wow_change_pct - a.wow_change_pct)\n  .map(s => `${s.state} ${labels[s.product]} ${signed(s.wow_change_pct)}`);\n\nconst lines = [\n  `⛽ FleetFuel Weekly — week of ${day}/${month}/${year}`,\n  '',\n  'National average (vs last week)',\n  ...nationalLines,\n  '',\n  'Biggest Diesel S10 increases',\n  topIncreases.length ? topIncreases.join('   ') : 'none',\n  '',\n  'Ethanol vs gasoline',\n  `Ethanol pays in ${states.filter(s => s.ethanol_pays).length} of ${states.length} states (ratio ${nationalRatio}%)`,\n  `Flipped to ethanol this week: ${list(flippedTo('flipped_to_ethanol'))}`,\n  `Flipped to gasoline this week: ${list(flippedTo('flipped_to_gasoline'))}`,\n  '',\n  `⚠️ Spikes above ${Number(data.config.spike_threshold_pct)}%: ${list(spikes)}`,\n];\n\nreturn [{ json: { text: lines.join('\\n') } }];\n"
      },
