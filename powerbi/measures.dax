// DAX for the ANP fuel price report (Power BI, Import mode on anp_fuel.gold).
// Model: fact_price[date_key] -> dim_date[date_key], fact_price[location_key] -> dim_location[location_key],
//        fact_price[product_key] -> dim_product[product_key] (all many-to-one, single direction).
// Mark dim_date as the date table (column dim_date[date]).
// Put the measures in a dedicated "_Measures" table (Enter data > empty table).


// ---------------------------------------------------------------- Base measures

Avg Price =
AVERAGE ( fact_price[sale_price] )
// Format: R$ #,0.000

Station Count =
DISTINCTCOUNT ( fact_price[station_id] )
// Format: #,0

// Last day with a price survey in the current filter context.
Last Data Date =
CALCULATE ( MAX ( dim_date[date] ), fact_price )


// ---------------------------------------------------------------- Current price and 12-month change

// Average price over the last month of data in context ("current" price on cards and the map).
Current Avg Price =
VAR LastDate = [Last Data Date]
RETURN
    CALCULATE ( [Avg Price], DATESINPERIOD ( dim_date[date], LastDate, -1, MONTH ) )
// Format: R$ #,0.000

// Same one-month window, twelve months earlier.
Avg Price 12M Ago =
VAR LastDate = [Last Data Date]
RETURN
    CALCULATE ( [Avg Price], DATESINPERIOD ( dim_date[date], EDATE ( LastDate, -12 ), -1, MONTH ) )
// Format: R$ #,0.000

Price Change 12M % =
VAR Prev = [Avg Price 12M Ago]
RETURN
    DIVIDE ( [Current Avg Price] - Prev, Prev )
// Format: +0.0%;-0.0%;0.0%


// ---------------------------------------------------------------- Fleet simulator (what-if parameters)
// Create with Modeling > New parameter > Numeric range, or as calculated tables:

Trucks =
GENERATESERIES ( 1, 500, 1 )
Trucks Value =
SELECTEDVALUE ( Trucks[Value], 10 )

Km per Truck =
GENERATESERIES ( 1000, 20000, 500 )
Km per Truck Value =
SELECTEDVALUE ( 'Km per Truck'[Value], 10000 )

Consumption =
GENERATESERIES ( 1.5, 5, 0.1 )
Consumption Value =
SELECTEDVALUE ( Consumption[Value], 2.5 )
// km per liter

// Fleet cost always uses DIESEL S10, whatever product is selected on the page.
Diesel S10 Price =
CALCULATE ( [Current Avg Price], REMOVEFILTERS ( dim_product ), dim_product[product] = "DIESEL S10" )
// Format: R$ #,0.000

Fleet Liters per Month =
DIVIDE ( [Trucks Value] * [Km per Truck Value], [Consumption Value] )
// Format: #,0

// Monthly cost = trucks x km per truck / (km per liter) x average DIESEL S10 price in the region.
Fleet Monthly Cost =
[Fleet Liters per Month] * [Diesel S10 Price]
// Format: R$ #,0
