model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_date","dim_location","dim_product","fact_price","Medidas","DatabricksHost","HttpPath"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_date
ref table dim_location
ref table dim_product
ref table fact_price
ref table Medidas

ref cultureInfo pt-BR

