table Medidas
	lineageTag: 78ee13c7-2abc-43b7-926c-36c37759b5df

	measure 'Avg Price' =
			
			AVERAGE ( fact_price[sale_price] )
		formatString: "R$"#,0.000;-"R$"#,0.000;"R$"#,0.000
		lineageTag: 54f2d24c-f9ff-43bf-b721-1d1b44d5ee56

		annotation PBI_FormatHint = {"currencyCulture":"es-BR"}

	measure 'Station Count' =
			
			DISTINCTCOUNT ( fact_price[station_id] )
		formatString: 0
		lineageTag: 1fabf04c-714b-47d1-a8ce-7da170047772

	measure 'Last Data Date' =
			
			CALCULATE ( MAX ( dim_date[date] ), fact_price )
		formatString: Short Date
		lineageTag: 175e739f-4a06-4a03-a8e9-7d19981ea792

	measure 'Current Avg Price' =
			
			VAR LastDate1 = [Last Data Date]
			RETURN
			    CALCULATE ( [Avg Price], DATESINPERIOD ( dim_date[date], LastDate1, -1, MONTH ) )
		formatString: "R$"#,0.000;-"R$"#,0.000;"R$"#,0.000
		lineageTag: 9c79dbe8-95cf-4b35-9085-fcd9bf07f8f1

		annotation PBI_FormatHint = {"currencyCulture":"es-BR"}

	measure 'Avg Price 12M Ago' =
			
			VAR LastDate1 = [Last Data Date]
			RETURN
			    CALCULATE ( [Avg Price], DATESINPERIOD ( dim_date[date], EDATE ( LastDate1, -12 ), -1, MONTH ) )
		formatString: "R$"#,0.000;-"R$"#,0.000;"R$"#,0.000
		lineageTag: fc7deb76-932e-442b-a700-d12433e52c5b

		annotation PBI_FormatHint = {"currencyCulture":"es-BR"}

	measure 'Price Change 12M %' =
			
			VAR Prev = [Avg Price 12M Ago]
			RETURN
			    DIVIDE ( [Current Avg Price] - Prev, Prev )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4598e944-26a9-48f8-ab1a-fc7f5c6756ae

	measure 'Diesel S10 Price' =
			
			CALCULATE ( [Current Avg Price], REMOVEFILTERS ( dim_product ), dim_product[product] = "DIESEL S10" )
		formatString: "R$"#,0.00;-"R$"#,0.00;"R$"#,0.00
		lineageTag: 59438967-fe79-4d1e-9832-7e89771e9431

		annotation PBI_FormatHint = {"currencyCulture":"es-BR"}

	measure 'Diff vs National Avg' =
			
			[Current Avg Price]
			    - CALCULATE ( [Current Avg Price], REMOVEFILTERS ( dim_location ) )
		formatString: "R$"#,0.00;-"R$"#,0.00;"R$"#,0.00
		lineageTag: 20836675-f5c1-416e-8b07-5486445e29fa

		annotation PBI_FormatHint = {"currencyCulture":"es-BR"}

	measure 'Price Diesel' =
			
			CALCULATE ( [Avg Price], dim_product[Product] = "DIESEL" )
		lineageTag: eada5782-f97e-41fc-a01d-3766b77414c6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Price Diesel S10' =
			
			CALCULATE ( [Avg Price], dim_product[Product] = "DIESEL S10" )
		lineageTag: 26949f6f-38ae-4b2c-a980-d9edda4cd65f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Price Gasolina' =
			
			CALCULATE ( [Avg Price], dim_product[Product] = "GASOLINA" )
		lineageTag: 2fe601f1-712e-490f-a279-50f47fa60457

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Price Etanol' =
			
			CALCULATE ( [Avg Price], dim_product[Product] = "ETANOL" )
		lineageTag: 107553c0-d7a3-4a8e-8eab-2e10d55d4d21

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Ethanol/Gasoline Ratio' =
			
			DIVIDE ( [Price Etanol], [Price Gasolina] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ae570136-4286-4bfe-8eee-e7a7f2e8c02d

	measure 'Best Fuel' =
			
			VAR _r = [Current Ethanol/Gasoline Ratio]
			RETURN
			    IF ( ISBLANK ( _r ), BLANK (), IF ( _r < 0.70, "Ethanol", "Gasoline" ) )
		lineageTag: 45df5465-fa4e-4333-a211-34e8a0543050

	measure 'States Where Ethanol Pays' =
			
			COUNTROWS (
			    FILTER ( VALUES ( dim_location[state2] ), [Current Ethanol/Gasoline Ratio] < 0.70 )
			)
		formatString: 0
		lineageTag: 8bf9a56f-046c-4382-8343-1e70bf354843

	measure 'Ratio Threshold' = 0.70
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 024cab67-007e-4bd2-ac92-495ef08171f2

	measure 'Ratio Gap' =
			
			[Current Ethanol/Gasoline Ratio] - [Ratio Threshold]
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 90f989e7-41c3-40ba-b89c-89905d23f939

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Current Price Etanol' =
			
			CALCULATE ( [Current Avg Price], dim_product[Product] = "ETANOL" )
		lineageTag: 435f3d26-8795-4020-8741-4272f1daa649

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Current Price Gasolina' =
			
			CALCULATE ( [Current Avg Price], dim_product[Product] = "GASOLINA" )
		lineageTag: cdecd21e-912d-4308-88a9-e62b2302e3a9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Current Ethanol/Gasoline Ratio' =
			
			DIVIDE ( [Current Price Etanol], [Current Price Gasolina] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 11b69685-117a-415a-bbbb-31c6aae17368

	measure 'Selected Products' =
			
			CONCATENATEX ( VALUES ( dim_product[product] ), dim_product[product], ", ", dim_product[product] )
		lineageTag: 1dbec4d5-4ddd-458d-b031-09d0353578c4

	partition Medidas = m
		mode: import
		source =
				let
				  Origem = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Colunas Removidas" = Table.RemoveColumns(Origem,{"Coluna 1"})
				in
				  #"Colunas Removidas"

	annotation PBI_ResultType = Table

